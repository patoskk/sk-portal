# Base CENTRAL del portal (Supabase nuevo)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...        # pública, respeta RLS (frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # SOLO backend (cron). Nunca exponer.

# Protege /api/cron/* (Vercel Cron manda este valor como Bearer)
CRON_SECRET=pon-un-secreto-largo-aleatorio

# (Opcional para Claude insights) — ver app/api/cron/insights
ANTHROPIC_API_KEY=sk-ant-...

# Piloto: key de LECTURA del Supabase de cada cliente, por client_id.
# Reemplazar los guiones del uuid por guiones bajos y en MAYÚSCULAS.
# Ej. cliente 1a2b... -> SOURCE_KEY_1A2B...  (en producción usar Supabase Vault)
# SOURCE_KEY_<CLIENT_ID>=eyJ...

# Aviso por mail de lecciones nuevas. El portal compone y n8n manda (ahí vive la
# credencial de Gmail). Importar n8n/aviso-leccion-workflow.json y pegar acá la
# URL de producción de su Webhook.
N8N_NOTIFY_WEBHOOK_URL=https://tu-n8n/webhook/aviso-leccion
NOTIFY_SECRET=pon-un-secreto-largo-aleatorio   # header x-portal-secret + Bearer del callback
PORTAL_URL=https://portal.skoptimal.com        # base de los links del mail
NOTIFY_FROM_NAME=Pato                          # con quién firma el mail (default: Pato)

# --- Ingesta de uso de herramientas (n8n -> portal) ---
# El workflow de cada cliente postea sus tool calls a /api/ingest/tool-events con
# este secreto en el header Authorization: Bearer. Es la ÚNICA fuente de "Acciones
# del agente": la memoria del agente no persiste las tool calls.
INGEST_SECRET=pon-un-secreto-largo-aleatorio

# Usuario de prueba para scripts/verify.ts (rotar si se filtra; NUNCA hardcodear)
TEST_USER_EMAIL=piloto@ejemplo.test
TEST_USER_PASSWORD=cambiame
